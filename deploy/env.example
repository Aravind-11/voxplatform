# Copy to deploy/.env (deploy/up.sh does this for you and generates the random values).
VOX_DOMAIN=voice.example.com           # DNS A record must point at this host; Caddy gets the certificate itself
VOX_UPSTREAMS=api1:8080 api2:8080      # add one entry per extra API node (other GPU hosts: ip:8080)
POSTGRES_PASSWORD=change-me
VOX_ADMIN_KEY=change-me-long-random
VOX_METRICS_TOKEN=change-me-long-random
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOX_TWILIO_NUMBER=
HF_TOKEN=
VLLM_TAG=latest
VOX_DEFAULT_CONCURRENCY=64
VOX_NO_ESPEAK=1                        # 1 = English only, no GPL code. Set 0 to enable es/fr/it/pt/hi (read docs/LICENSES.md)
VOX_PRELOAD_LANGS=a                    # Kokoro language codes loaded at start (a,b en; e es; f fr; h hi; i it; p pt; j ja; z zh)

# SIP (VoxSun or any SIP provider) via Asterisk, see docs/SIP.md. Set the port to 9092 and the agent id to turn it on.
VOX_AUDIOSOCKET_PORT=0
VOX_SIP_AGENT=
VOX_SIP_TOKEN=                         # setup, recover, amd, bind, and transfer; empty disables those endpoints
VOX_AUDIOSOCKET_RATE=16000             # 16000 with g722/slin16; 8000 if the trunk is ulaw/alaw only
ASTERISK_ARI_URL=                      # e.g. http://asterisk:8088 — SIP outbound, machine hangup, and cold transfer via the dialplan
ASTERISK_ARI_USER=
ASTERISK_ARI_PASSWORD=
