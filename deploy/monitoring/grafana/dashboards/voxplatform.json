{
 "uid": "voxplatform",
 "title": "VoxPlatform",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Active calls (per node)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "vox_active_calls",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Calls finished per minute, by reason",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(vox_calls_total[5m])) * 60",
     "legendFormat": "{{reason}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "First audio after caller stops (ms)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(vox_first_audio_ms_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vox_first_audio_ms_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Errors per minute, by component",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (where) (rate(vox_errors_total[5m])) * 60",
     "legendFormat": "{{where}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Interruptions and turns per minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(vox_interruptions_total[5m])) * 60",
     "legendFormat": "interruptions"
    },
    {
     "refId": "B",
     "expr": "sum(rate(vox_turns_total[5m])) * 60",
     "legendFormat": "turns"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Tool calls per minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tool) (rate(vox_tool_calls_total[5m])) * 60",
     "legendFormat": "{{tool}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Model first token (ms, p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vox_llm_first_token_ms_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Speech synthesis (ms, p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vox_tts_ms_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 9,
   "type": "stat",
   "title": "Reconnected calls (last 10 min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(vox_call_resumes_total[10m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 10,
   "type": "stat",
   "title": "Nodes up",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job='voxplatform'}",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Model requests waiting",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(vllm:num_requests_waiting)",
     "legendFormat": ""
    }
   ]
  }
 ],
 "tags": [
  "voxplatform"
 ]
}